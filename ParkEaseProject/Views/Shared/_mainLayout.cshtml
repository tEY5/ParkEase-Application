
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <!--For SweetAlert-->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!--For Tailwind css-->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!--For the font-->
    <script>
                tailwind.config = {
                    theme: {
                        extend: {
                            fontFamily: {
                                sans: ['"Plus Jakarta Sans"', 'ui-sans-serif', 'system-ui', 'sans-serif'],
                            },
                        },
                    },
                }

    </script>
</head>
<body ng-app="ParkEaseProjectModule" ng-controller="ParkEaseProjectController" class="bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 min-h-screen text-slate-100 flex flex-col justify-between font-sans antialiased relative overflow-x-hidden">
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
        <div class="absolute -top-32 -left-32 w-96 h-96 bg-violet-600/15 rounded-full blur-3xl"></div>
        <div class="absolute top-1/3 -right-32 w-[30rem] h-[30rem] bg-orange-500/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-32 left-1/3 w-[28rem] h-[28rem] bg-blue-600/15 rounded-full blur-3xl"></div>
    </div>
    <!--For the logo and name-->
    <header class="w-full px-4 pt-4 pb-2 z-40">
        <nav class="max-w-7xl mx-auto backdrop-blur-md bg-white/10 border border-white/20 rounded-full px-6 md:px-8 py-3.5 flex items-center justify-between shadow-lg shadow-black/10 transition-all">

            <a href="/Main/HomePage" class="flex items-center space-x-2.5 group">
                <div class="w-7 h-7 flex items-center justify-center text-violet-400 group-hover:scale-105 transition-transform">
                    <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2L3 20H8.5L12 12.5L15.5 20H21L12 2Z" fill="#8B5CF6" />
                    </svg>
                </div>
                <span class="text-white font-bold text-lg tracking-tight">ParkEase</span>
            </a>

            <nav class="hidden md:flex items-center space-x-1 text-sm font-medium">
                <ul class="flex items-center space-x-2">
                    <li ng-repeat="link in navLinks">
                        <a href="{{link.url}}"
                           class="px-4 py-2 rounded-full transition text-slate-200 hover:text-white hover:bg-white/10"
                           ng-class="{'bg-white/15 text-white font-semibold': currentActivePage === link.key}">
                            {{link.title}}
                        </a>
                    </li>
                </ul>
            </nav>
            <!--For the logged in/out button-->
            <div class="flex items-center min-w-[130px] justify-end">
                <!-- Shown when logged in -->
                <div ng-if="isLoggedIn" class="flex items-center space-x-3">
                    <div class="relative w-8 h-8 rounded-full overflow-hidden bg-violet-100 border border-white/40 flex-shrink-0 cursor-pointer" title="User Profile">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80" alt="Avatar" class="w-full h-full object-cover">
                        <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-500 border-2 border-slate-900 rounded-full"></span>
                    </div>
                    <button type="button" ng-click="logoutFunc()" class="bg-white hover:bg-slate-100 text-violet-700 font-semibold px-4 py-1.5 rounded-full text-xs transition shadow-sm active:scale-95">
                        Logout
                    </button>
                </div>

                <!-- Shown when logged out -->
                <div ng-if="!isLoggedIn" class="flex items-center space-x-2">
                    <a href="/Main/LoginPage" class="bg-violet-600 hover:bg-violet-700 text-white font-medium px-4 py-1.5 rounded-full text-xs transition shadow-sm">
                        Login
                    </a>
                </div>
            </div>
        </nav>
    </header>
    <main class="w-full flex-grow flex items-center justify-center p-4">
        @RenderBody()
    </main>

    <!-- Footer -->

    <footer class="w-full px-4 pb-6 pt-10 mt-auto z-40">

        <div class="max-w-7xl mx-auto backdrop-blur-md bg-white/10 border border-white/20 rounded-full px-6 md:px-8 py-3.5 flex flex-col md:flex-row items-center justify-between shadow-lg shadow-black/10 text-xs text-slate-300 gap-4 md:gap-0">

            <div class="flex items-center space-x-2">

                <svg class="w-5 h-5 text-violet-400" viewBox="0 0 24 24" fill="currentColor">

                    <path d="M12 2L3 20H8.5L12 12.5L15.5 20H21L12 2Z" fill="#8B5CF6" />

                </svg>

                <span class="text-white font-bold text-base tracking-tight">ParkEase</span>

            </div>



            <div class="text-slate-300 text-center md:text-left text-xs font-normal">

                Effortless Parking Management. Secure. Transparent. Smart.

            </div>



            <div class="text-slate-300/90 text-xs font-normal">

                &copy; 2026 ParkEase. All rights reserved.

            </div>



            <div class="flex items-center space-x-4 text-white">

                <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="hover:text-violet-400 transition" title="Facebook">

                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" /></svg>

                </a>

                <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="hover:text-violet-400 transition" title="Twitter">

                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.936 9.936 0 0024 4.59z" /></svg>

                </a>

                <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="hover:text-violet-400 transition" title="LinkedIn">

                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" /></svg>

                </a>

                <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="hover:text-violet-400 transition" title="Instagram">

                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" /></svg>

                </a>

            </div>

        </div>

    </footer>
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/angular.min.js"></script>
    <script src="~/Scripts/HolyScripts/Module.js"></script>
    <script src="~/Scripts/HolyScripts/Service.js"></script>
    <script src="~/Scripts/HolyScripts/Controller.js"></script>
</body>
</html>
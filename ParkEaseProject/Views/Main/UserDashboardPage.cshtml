@{
    Layout = "~/Views/Shared/_mainLayout.cshtml";
    ViewBag.Title = "Personal Client Dashboard";
}

<div class="w-full max-w-5xl mx-auto py-6 space-y-8">

    <!-- Profile & Information Modification Section -->
    <div class="bg-white rounded-[32px] shadow-xl p-6 md:p-8 border border-slate-100 text-slate-800">
        <div class="mb-6">
            <h2 class="text-xl font-bold text-slate-900 tracking-tight">My Profile Information</h2>
            <p class="text-slate-400 text-sm mt-0.5">Update your personal account details and vehicle plate number.</p>
        </div>

        <form class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-medium text-slate-500 mb-1.5">First Name</label>
                    <input type="text" ng-model="clientProfile.FName" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-slate-800 text-sm focus:ring-2 focus:ring-violet-500 transition" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-500 mb-1.5">Last Name</label>
                    <input type="text" ng-model="clientProfile.LName" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-slate-800 text-sm focus:ring-2 focus:ring-violet-500 transition" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-medium text-slate-500 mb-1.5">Email Address</label>
                    <input type="email" ng-model="clientProfile.Email" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-slate-800 text-sm focus:ring-2 focus:ring-violet-500 transition" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-500 mb-1.5">Plate Number</label>
                    <input type="text" ng-model="clientProfile.PlateNumber" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-slate-800 text-sm focus:ring-2 focus:ring-violet-500 transition" />
                </div>
            </div>

            <div class="pt-2">
                <button type="button" ng-click="updateProfile()" class="bg-violet-600 hover:bg-violet-700 text-white font-medium py-2.5 px-5 rounded-lg text-sm transition">
                    Save Changes
                </button>
            </div>
        </form>
    </div>

    <!-- Password Change Section -->
    <div class="bg-white rounded-[32px] shadow-xl p-6 md:p-8 border border-slate-100 text-slate-800">
        <div class="mb-6">
            <h2 class="text-xl font-bold text-slate-900 tracking-tight">Security &amp; Password</h2>
            <p class="text-slate-400 text-sm mt-0.5">Ensure your account is secure by updating your password regularly.</p>
        </div>

        <form class="space-y-4">
            <div>
                <label class="block text-xs font-medium text-slate-500 mb-1.5">Current Password</label>
                <input type="password" ng-model="passwordForm.CurrentPassword" placeholder="••••••••" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-slate-800 text-sm focus:ring-2 focus:ring-violet-500 transition" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-medium text-slate-500 mb-1.5">New Password</label>
                    <input type="password" ng-model="passwordForm.NewPassword" placeholder="••••••••" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-slate-800 text-sm focus:ring-2 focus:ring-violet-500 transition" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-500 mb-1.5">Confirm New Password</label>
                    <input type="password" ng-model="passwordForm.ConfirmPassword" placeholder="••••••••" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-slate-800 text-sm focus:ring-2 focus:ring-violet-500 transition" />
                </div>
            </div>

            <div class="pt-2">
                <button type="button" ng-click="updatePassword()" class="bg-slate-900 hover:bg-slate-800 text-white font-medium py-2.5 px-5 rounded-lg text-sm transition">
                    Update Password
                </button>
            </div>
        </form>
    </div>

    <!-- Personal Violations Table Section -->
    <div class="bg-white rounded-[32px] shadow-xl p-6 md:p-8 border border-slate-100 text-slate-800">
        <div class="mb-5">
            <h2 class="text-xl font-bold text-slate-900 tracking-tight">My Parking Violations</h2>
            <p class="text-slate-400 text-sm mt-0.5">Review any citations or pending enforcement notices issued to your vehicle.</p>
        </div>

        <div class="overflow-x-auto border border-slate-100 rounded-2xl">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50 text-slate-500 text-xs font-semibold uppercase tracking-wider">
                        <th class="py-3 px-4">Violation Type</th>
                        <th class="py-3 px-4">Date Issued</th>
                        <th class="py-3 px-4">Fine Amount</th>
                        <th class="py-3 px-4">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm text-slate-700">
                    <tr ng-repeat="v in clientViolations" class="hover:bg-slate-50/80 transition">
                        <td class="py-3.5 px-4 font-medium text-slate-900">{{v.ViolationType}}</td>
                        <td class="py-3.5 px-4 text-slate-600">{{v.DateIssued | date:'mediumDate'}}</td>
                        <td class="py-3.5 px-4 text-slate-600">₱{{v.FineAmount}}</td>
                        <td class="py-3.5 px-4">
                            <span class="px-2.5 py-1 bg-rose-50 text-rose-700 border border-rose-100 rounded-full text-xs font-semibold">
                                {{v.Status}}
                            </span>
                        </td>
                    </tr>
                    <tr ng-if="!clientViolations || clientViolations.length === 0">
                        <td colspan="4" class="py-8 text-center text-slate-400 text-sm">
                            No violations recorded for your vehicle. Excellent driving!
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>
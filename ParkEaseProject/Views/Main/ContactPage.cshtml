@{
    Layout = "~/Views/Shared/_mainLayout.cshtml";
    ViewBag.Title = "Contact Us";
}

<div class="w-full max-w-4xl mx-auto my-auto py-6">
    <div class="bg-white rounded-[32px] shadow-2xl border border-slate-100 p-8 md:p-10 text-slate-800">

        <div class="flex items-center space-x-4 mb-6">
            <div class="w-12 h-12 rounded-2xl bg-orange-50 border border-orange-100 flex items-center justify-center text-orange-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
            </div>
            <div>
                <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Contact &amp; Support</h1>
                <p class="text-slate-500 text-sm">Parking Administration Office Desk</p>
            </div>
        </div>

        <div class="h-px bg-slate-100 w-full mb-8"></div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 space-y-3">
                <div class="flex items-center space-x-3 text-violet-600">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <h3 class="font-bold text-slate-900 text-sm">Office Location</h3>
                </div>
                <p class="text-xs text-slate-600 leading-relaxed">
                    Ground Floor, Quadricentennial Pavilion<br>
                    University of Santo Tomas<br>
                    España Blvd, Sampaloc, Manila 1008
                </p>
            </div>

            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 space-y-3">
                <div class="flex items-center space-x-3 text-orange-600">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                    <h3 class="font-bold text-slate-900 text-sm">Email Support</h3>
                </div>
                <p class="text-xs text-slate-600 leading-relaxed">
                    General Inquiries: <a href="mailto:support@parkease.ust.edu.ph" class="text-violet-600 hover:underline">support@parkease.ust.edu.ph</a><br>
                    Admin Office: <a href="mailto:parking.admin@ust.edu.ph" class="text-violet-600 hover:underline">parking.admin@ust.edu.ph</a>
                </p>
            </div>

            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 space-y-3">
                <div class="flex items-center space-x-3 text-emerald-600">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                    </svg>
                    <h3 class="font-bold text-slate-900 text-sm">Hotline &amp; Telephone</h3>
                </div>
                <p class="text-xs text-slate-600 leading-relaxed">
                    Direct Line: +63 (02) 8786-1611 loc. 8440<br>
                    Campus Security Desk: +63 (02) 8731-3101
                </p>
            </div>

            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 space-y-3">
                <div class="flex items-center space-x-3 text-blue-600">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <h3 class="font-bold text-slate-900 text-sm">Office Hours</h3>
                </div>
                <p class="text-xs text-slate-600 leading-relaxed">
                    Monday to Friday: 8:00 AM – 5:00 PM<br>
                    Saturday: 8:00 AM – 12:00 PM<br>
                    Sunday &amp; Holidays: Closed
                </p>
            </div>
        </div>

        <div class="mt-8 pt-6 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs text-slate-400">ParkEase Support Desk</span>
            <span class="text-xs text-slate-400 font-medium">University of Santo Tomas</span>
        </div>

    </div>
</div>
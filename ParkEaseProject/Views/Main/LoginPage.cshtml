@{
    Layout = "~/Views/Shared/_mainLayout.cshtml";
    ViewBag.Title = "Login";
}

<div class="w-full max-w-4xl mx-auto my-auto py-6">
    <div class="bg-white rounded-[32px] shadow-2xl p-4 md:p-6 flex flex-col md:flex-row gap-6 md:gap-8 items-stretch border border-slate-100 text-slate-800">

        <!-- Left Brand Banner -->
        <div class="w-full md:w-5/12 bg-black rounded-[24px] p-8 md:p-10 flex flex-col justify-between relative overflow-hidden min-h-[440px] shadow-inner">
            <div class="absolute inset-0 pointer-events-none">
                <div class="absolute bottom-0 left-0 right-0 h-3/5 bg-gradient-to-t from-orange-600/35 via-amber-600/15 to-transparent"></div>
                <div class="absolute bottom-0 left-6 w-10 h-64 bg-gradient-to-t from-amber-500/40 via-orange-600/20 to-transparent blur-md"></div>
                <div class="absolute bottom-0 left-20 w-14 h-80 bg-gradient-to-t from-orange-500/45 via-amber-500/20 to-transparent blur-lg"></div>
                <div class="absolute bottom-0 left-36 w-8 h-56 bg-gradient-to-t from-orange-600/30 via-amber-600/10 to-transparent blur-md"></div>
            </div>

            <div class="relative z-10">
                <h2 class="text-white text-3xl md:text-4xl font-extrabold tracking-tight leading-snug">
                    Access ParkEase.<br>
                    <span class="font-normal text-slate-200">Manage your parking account.</span>
                </h2>
            </div>

            <div class="relative z-10 text-xs text-slate-400 font-medium tracking-wider uppercase">
                Parking Management &amp; Portal
            </div>
        </div>

        <!-- Right Form Section -->
        <div class="w-full md:w-7/12 flex flex-col justify-center px-2 md:px-6 py-4">

            <div class="mb-5">
                <div class="flex items-center space-x-3 mb-2">
                    <div class="w-10 h-10 flex items-center justify-center">
                        <svg class="w-10 h-10" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M20 5C14.5 7 8 7 7 9V20C7 26.5 12.8 32.5 20 35V5Z" fill="#7C3AED" fill-opacity="0.15" stroke="#7C3AED" stroke-width="2.5" stroke-linejoin="round" />
                            <path d="M20 5C25.5 7 32 7 33 9V20C33 26.5 27.2 32.5 20 35V5Z" fill="#10B981" fill-opacity="0.15" stroke="#10B981" stroke-width="2.5" stroke-linejoin="round" />
                            <path d="M14.5 12H19.5C21.5 12 22.8 13.2 22.8 15.2C22.8 17.2 21.5 18.4 19.5 18.4H16.8V24H14.5V12Z" fill="#6D28D9" />
                            <path d="M16.8 14.1V16.3H19.3C20 16.3 20.5 15.9 20.5 15.2C20.5 14.5 20 14.1 19.3 14.1H16.8Z" fill="white" />
                            <path d="M17.5 21L21.5 25L30 15.5" stroke="#10B981" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Welcome Back</h1>
                    </div>
                </div>
                <p class="text-slate-400 text-sm">Sign in to manage your parking</p>
                <div class="h-px bg-slate-100 w-full mt-4"></div>
            </div>

            <!-- Form with functionality removed -->
            <form ng-submit="loginFunc()" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Username</label>
                    <input type="text" ng-model="loginData.username" required
                           class="w-full bg-slate-50 border border-slate-300 rounded-lg px-3.5 py-2.5 text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-violet-500 focus:bg-white transition"
                           placeholder="Enter your username">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Password</label>
                    <input type="password" ng-model="loginData.password" required
                           class="w-full bg-slate-50 border border-slate-300 rounded-lg px-3.5 py-2.5 text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-violet-500 focus:bg-white transition"
                           placeholder="••••••••">
                </div>

                <div class="flex items-center space-x-3 pt-3">
                    <button type="submit" class="flex-1 bg-violet-600 hover:bg-violet-700 text-white font-medium py-2.5 px-5 rounded-lg shadow-sm shadow-violet-600/20 active:scale-95 transition text-sm text-center">Sign In</button>
                    <button type="button" ng-click="clearLoginFunc()" class="px-6 py-2.5 rounded-lg border border-slate-300 hover:border-slate-400 text-slate-700 font-medium text-sm hover:bg-slate-50 active:scale-95 transition">Clear</button>
                </div>

                <div class="text-center pt-2">
                    <p class="text-xs text-slate-500">
                        Don't have an account?
                        <a href="/Main/RegistrationPage" class="text-violet-600 font-semibold hover:underline">Register now</a>
                    </p>
                </div>
            </form>

        </div>

    </div>
</div>
@{
    Layout = "~/Views/Shared/_mainLayout.cshtml";
    ViewBag.Title = "ParkEase - Home";
}

<div class="w-full max-w-6xl mx-auto py-6 space-y-8">

    <!-- Hero Section -->
    <div class="bg-gradient-to-br from-slate-900 via-violet-950 to-slate-900 rounded-[36px] p-8 md:p-12 border border-white/10 shadow-2xl text-white relative overflow-hidden">
        <div class="absolute inset-0 pointer-events-none">
            <div class="absolute top-0 right-0 w-96 h-96 bg-violet-600/20 rounded-full blur-3xl"></div>
            <div class="absolute bottom-0 left-1/3 w-80 h-80 bg-orange-500/15 rounded-full blur-3xl"></div>
        </div>

        <div class="relative z-10 max-w-2xl space-y-4">
            <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse mr-2"></span>
                MMDA NCAP Parking Portal Active
            </span>
            <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight leading-tight">
                @ViewBag.WelcomeMessage
            </h1>
            <p class="text-slate-300 text-sm md:text-base leading-relaxed">
                Streamlining campus parking management, real-time bay allocation, and transparent violation enforcement for students, faculty, and administrators.
            </p>
            <div class="flex flex-wrap items-center gap-3 pt-2">
                <a href="/Main/LoginPage" class="bg-orange-600 hover:bg-orange-700 text-white font-semibold px-6 py-3 rounded-2xl text-sm shadow-lg shadow-orange-600/30 transition active:scale-95">
                    Sign In to Portal
                </a>
                <a href="/Main/RegistrationPage" class="bg-white/10 hover:bg-white/20 text-white border border-white/20 font-semibold px-6 py-3 rounded-2xl text-sm transition active:scale-95">
                    Register New Account
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Metrics / System Highlights -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="bg-white rounded-[28px] p-6 shadow-xl border border-slate-100 flex items-center space-x-4">
            <div class="w-14 h-14 rounded-2xl bg-violet-50 text-violet-600 flex items-center justify-center text-xl font-bold border border-violet-100">
                🅿️
            </div>
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Campus Parking Bays</p>
                <h3 class="text-2xl font-extrabold text-slate-900 mt-0.5">1,420 Slots</h3>
                <p class="text-xs text-emerald-600 font-medium mt-0.5">Live Occupancy Monitored</p>
            </div>
        </div>

        <div class="bg-white rounded-[28px] p-6 shadow-xl border border-slate-100 flex items-center space-x-4">
            <div class="w-14 h-14 rounded-2xl bg-orange-50 text-orange-600 flex items-center justify-center text-xl font-bold border border-orange-100">
                ⚖️
            </div>
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400">NCAP Enforcement</p>
                <h3 class="text-2xl font-extrabold text-slate-900 mt-0.5">Automated</h3>
                <p class="text-xs text-slate-500 font-medium mt-0.5">Violation &amp; Fine Tracking</p>
            </div>
        </div>

        <div class="bg-white rounded-[28px] p-6 shadow-xl border border-slate-100 flex items-center space-x-4">
            <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl font-bold border border-emerald-100">
                🛡️
            </div>
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Security Access</p>
                <h3 class="text-2xl font-extrabold text-slate-900 mt-0.5">Role-Based</h3>
                <p class="text-xs text-emerald-600 font-medium mt-0.5">Secure Admin &amp; User Portals</p>
            </div>
        </div>
    </div>

    <!-- Portal Navigation Feature Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Administrator Card -->
        <div class="bg-white rounded-[32px] shadow-xl p-8 border border-slate-100 flex flex-col justify-between space-y-6">
            <div class="space-y-3">
                <div class="w-12 h-12 rounded-2xl bg-slate-900 text-white flex items-center justify-center font-bold text-lg">
                    ⚙️
                </div>
                <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">Administrator Portal</h2>
                <p class="text-slate-500 text-sm leading-relaxed">
                    Designed for authorized campus parking administrators. Oversee user accounts, edit basic details (First, Middle, Last names, and Email), and issue formal parking violation citations following the NCAP standard.
                </p>
            </div>
            <div>
                <a href="/Main/LoginPage" class="inline-flex items-center space-x-2 text-sm font-semibold text-slate-900 hover:text-orange-600 transition">
                    <span>Access Admin Controls</span>
                    <span>&rarr;</span>
                </a>
            </div>
        </div>

        <!-- User / Driver Card -->
        <div class="bg-white rounded-[32px] shadow-xl p-8 border border-slate-100 flex flex-col justify-between space-y-6">
            <div class="space-y-3">
                <div class="w-12 h-12 rounded-2xl bg-violet-100 text-violet-700 flex items-center justify-center font-bold text-lg">
                    👤
                </div>
                <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">Personal Client Dashboard</h2>
                <p class="text-slate-500 text-sm leading-relaxed">
                    For students and faculty car owners. Manage your profile data, securely update your personal account password, and check real-time violation records or pending fines assigned to your vehicle.
                </p>
            </div>
            <div>
                <a href="/Main/LoginPage" class="inline-flex items-center space-x-2 text-sm font-semibold text-violet-600 hover:text-violet-700 transition">
                    <span>Open User Dashboard</span>
                    <span>&rarr;</span>
                </a>
            </div>
        </div>

    </div>

</div>